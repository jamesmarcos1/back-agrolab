  "components": {
    "schemas": {
      "ChallengeOutput": {
        "properties": {
          "registration_token": {
            "type": "string",
            "title": "Registration Token"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          },
          "resend_after": {
            "type": "integer",
            "title": "Resend After"
          }
        },
        "type": "object",
        "required": [
          "registration_token",
          "expires_in",
          "resend_after"
        ],
        "title": "ChallengeOutput"
      },
      "DeleteInput": {
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "password"
        ],
        "title": "DeleteInput"
      },
      "EmailInput": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email"
        ],
        "title": "EmailInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginInput": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginInput"
      },
      "RefreshInput": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "maxLength": 128,
            "minLength": 32,
            "title": "Refresh Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "RefreshInput"
      },
      "RegisterInput": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 12,
            "title": "Password"
          },
          "accepted_terms": {
            "type": "boolean",
            "const": true,
            "title": "Accepted Terms"
          },
          "privacy_policy_version": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Privacy Policy Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "name",
          "password",
          "accepted_terms",
          "privacy_policy_version"
        ],
        "title": "RegisterInput"
      },
      "ResendInput": {
        "properties": {
          "registration_token": {
            "type": "string",
            "maxLength": 128,
            "minLength": 32,
            "title": "Registration Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "registration_token"
        ],
        "title": "ResendInput"
      },
      "ResetInput": {
        "properties": {
          "reset_token": {
            "type": "string",
            "maxLength": 128,
            "minLength": 32,
            "title": "Reset Token"
          },
          "new_password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 12,
            "title": "New Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reset_token",
          "new_password"
        ],
        "title": "ResetInput"
      },
      "SessionOutput": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          },
          "token_type": {
            "type": "string",
            "const": "bearer",
            "title": "Token Type",
            "default": "bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          },
          "user": {
            "$ref": "#/components/schemas/UserOutput"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "refresh_token",
          "expires_in",
          "user"
        ],
        "title": "SessionOutput"
      },
      "UserOutput": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "email_verified": {
            "type": "boolean",
            "title": "Email Verified"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "email_verified"
        ],
        "title": "UserOutput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VerifyInput": {
        "properties": {
          "registration_token": {
            "type": "string",
            "maxLength": 128,
            "minLength": 32,
            "title": "Registration Token"
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "title": "Code"
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "registration_token",
          "code",
          "password"
        ],
        "title": "VerifyInput"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}